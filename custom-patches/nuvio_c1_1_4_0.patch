diff --git a/js/ui/screens/home/c1HeroEntrance.js b/js/ui/screens/home/c1HeroEntrance.js
new file mode 100644
index 0000000..d90283f
--- /dev/null
+++ b/js/ui/screens/home/c1HeroEntrance.js
@@ -0,0 +1,52 @@
+import { preloadImageSource } from "./homeScreenHelpers-02-extract-release-date-text.js";
+import { Router } from "../../navigation/routerState.js";
+
+function enabled(screen) {
+  return screen.layoutMode === "modern" &&
+    document.documentElement.classList.contains("webos-2021-fast-resume");
+}
+
+export function prepareC1HeroEntrance(screen) {
+  if (enabled(screen) && !screen.c1HeroEntranceShown) {
+    screen.container?.classList.add("c1-hero-entrance-pending");
+  }
+}
+
+export function revealC1HeroEntrance(screen, node, hero, display) {
+  if (!enabled(screen) || !node || !hero) return;
+  if (screen.c1HeroEntranceShown) {
+    // A new title or refresh must never inherit the first hero's fade.
+    screen.c1HeroEntranceAnimation?.cancel();
+    screen.c1HeroEntranceAnimation = null;
+    return;
+  }
+  const token = (screen.c1HeroEntranceToken || 0) + 1;
+  screen.c1HeroEntranceToken = token;
+  if (hero.heroMetaEnriching) return;
+  const identity = String(hero.id || "");
+  const current = () => screen.c1HeroEntranceToken === token &&
+    !screen.c1HeroEntranceShown && Router.getCurrent() === "home" &&
+    (!screen.heroItem || String(screen.heroItem.id || "") === identity) &&
+    screen.container?.contains(node) && String(node.dataset.itemId || "") === identity;
+  // Reuse the bounded image preload cache already used by the instant swaps.
+  Promise.all([preloadImageSource(display?.backdrop), preloadImageSource(display?.logo)])
+    .then(() => {
+      if (!current()) return;
+      requestAnimationFrame(() => {
+        if (!current()) return;
+        screen.c1HeroEntranceShown = true;
+        screen.container.classList.remove("c1-hero-entrance-pending");
+        const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
+        if (!reduced && typeof node.animate === "function") {
+          try {
+            screen.c1HeroEntranceAnimation = node.animate(
+              [{ opacity: 0 }, { opacity: 1 }],
+              { duration: 180, easing: "ease-out" }
+            );
+          } catch (_) {
+            // Visibility is already restored if this engine rejects animation.
+          }
+        }
+      });
+    });
+}
diff --git a/js/ui/screens/home/homeImageCommitQueue.test.mjs b/js/ui/screens/home/homeImageCommitQueue.test.mjs
new file mode 100644
index 0000000..3772b5b
--- /dev/null
+++ b/js/ui/screens/home/homeImageCommitQueue.test.mjs
@@ -0,0 +1,88 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import vm from "node:vm";
+
+const source = await readFile(
+  new URL("./homeScreenMethods-24-schedule-home-lazy-image-hydration.js", import.meta.url),
+  "utf8"
+);
+
+function makeContext() {
+  const frames = [];
+  const context = vm.createContext({
+    internals: { HOME_LEGACY_LAZY_HYDRATION_MAX_PER_FRAME: 2 },
+    requestAnimationFrame: (callback) => {
+      frames.push(callback);
+      return frames.length;
+    }
+  });
+  context.HTMLElement = class {};
+  context.HTMLImageElement = class extends context.HTMLElement {};
+  context.globalThis = context;
+  // The factory already exists in the app. Stub just its imports so the test
+  // calls the real queue implementation without loading the whole Home UI.
+  const code = source
+    .replace(/^import [\s\S]*?;\s*/gm, "")
+    .replace("export function", "function");
+  vm.runInContext(`${code}\nglobalThis.methods = createHomeScreenMethods24();`, context);
+  return { frames, context };
+}
+
+function image(context, id) {
+  const node = new context.HTMLImageElement();
+  node.id = id;
+  node.dataset = { src: id };
+  node.isConnected = true;
+  node.closest = () => null;
+  return node;
+}
+
+test("Home queue deduplicates rapid focus entries and prioritizes the new focus", () => {
+  const { context, frames } = makeContext();
+  const row = {};
+  const first = image(context, "first");
+  const second = image(context, "second");
+  const focused = image(context, "focused");
+  const started = [];
+  const screen = {
+    ...context.methods,
+    assignHomeLazyImageSource(node) {
+      started.push(node.id);
+      delete node.dataset.src;
+    }
+  };
+  const entries = [first, second].map((node) => ({ image: node, src: node.id, row, priority: 2 }));
+  screen.commitHomeLazyImageSources(entries, null, row);
+  // Re-queueing an existing pending poster must not duplicate its request.
+  screen.commitHomeLazyImageSources(entries, null, row);
+  assert.equal(screen.homeLazyImageCommitQueue.length, 2);
+
+  const anchor = { contains: (node) => node === focused };
+  screen.commitHomeLazyImageSources([{ image: focused, src: focused.id, row, priority: 0 }], anchor, row);
+  assert.equal(screen.homeLazyImageCommitQueue.length, 3);
+  while (frames.length) frames.shift()();
+  assert.equal(started.length, 3);
+  assert.equal(started[0], "focused", "focused card should take the first slot");
+});
+
+test("Home queue drops images detached during navigation", () => {
+  const { context, frames } = makeContext();
+  const row = {};
+  const stale = image(context, "stale");
+  const live = image(context, "live");
+  const started = [];
+  const screen = {
+    ...context.methods,
+    assignHomeLazyImageSource(node) {
+      started.push(node.id);
+      delete node.dataset.src;
+    }
+  };
+  screen.commitHomeLazyImageSources([{ image: stale, src: "stale", row, priority: 1 }], null, row);
+  stale.isConnected = false;
+  screen.commitHomeLazyImageSources([{ image: live, src: "live", row, priority: 1 }], null, row);
+  assert.equal(screen.homeLazyImageCommitQueue.length, 1);
+  while (frames.length) frames.shift()();
+  assert.deepEqual(started, ["live"]);
+});
