@@ -0,0 +1,98 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+const root = process.env.HERO_SOURCE || '.';
+function fixture(kind) {
+  const file = kind === 'backdrop' ? '03-animate-hero-backdrop-swap' : '04-animate-hero-logo-swap';
+  const source = fs.readFileSync(`${root}/js/ui/screens/home/homeScreenHelpers-${file}.js`, 'utf8');
+  const pending = [];
+  const frames = [];
+  let ghosts = 0;
+  let enters = 0;
+  class Img {
+    constructor() {
+      this.attrs = { src: 'old' };
+      const classes = new Set();
+      this.classList = { add: (...xs) => xs.forEach(x => classes.add(x)), remove: (...xs) => xs.forEach(x => classes.delete(x)), contains: x => classes.has(x) };
+      this.parentElement = { querySelectorAll: () => [], insertBefore: () => ghosts++ };
+    }
+    getAttribute(k) { return this.attrs[k]; }
+    setAttribute(k, v) { this.attrs[k] = v; }
+    removeAttribute(k) { delete this.attrs[k]; }
+    remove() { this.removed = true; }
+    cloneNode() { return new Img(); }
+  }
+  const ctx = vm.createContext({ HTMLImageElement: Img, HOME_MODERN_HERO_BACKDROP_CROSSFADE_MS: 400,
+    preloadImageSource: src => new Promise(resolve => pending.push({ src, resolve })),
+    prepareHeroImageEnter: () => enters++, requestAnimationFrame: fn => frames.push(fn), setTimeout: () => {} });
+  vm.runInContext(source.replace(/^import [\s\S]*?;\s*/gm, '').replaceAll('export function', 'function'), ctx);
+  const fn = ctx[kind === 'backdrop' ? 'animateHeroBackdropSwap' : 'animateHeroLogoSwap'];
+  return { img: new Img(), pending, frames, swap: fn, ghosts: () => ghosts, enters: () => enters };
+}
+test('C1 starts available backdrop during metadata enrichment; other TVs retain upstream behavior', () => {
+  const source = fs.readFileSync(`${root}/js/ui/screens/home/homeScreenMethods-05-apply-hero-to-dom.js`, 'utf8');
+  for (const isC1 of [true, false]) {
+    const f = fixture('backdrop');
+    const swaps = [];
+    const heroNode = {
+      dataset: {}, classList: { toggle() {}, remove() {} },
+      querySelector: selector => selector.startsWith('.home-hero-backdrop:') ? f.img : null,
+      querySelectorAll: () => []
+    };
+    const ctx = vm.createContext({
+      document: { documentElement: { classList: { contains: () => isC1 } } },
+      HTMLImageElement: f.img.constructor,
+      ensureHeroMdbListRatings() {}, registerHomeDomNodes() {}, revealC1HeroEntrance() {},
+      internals: {
+        getTvHeroTransitionMode: () => 'single-layer',
+        buildModernHeroPresentation: () => ({ backdrop: 'new', title: 'New title' }),
+        animateHeroBackdropSwap: (...args) => swaps.push(args)
+      }
+    });
+    vm.runInContext(source.replace(/^import [\s\S]*?;\s*/gm, '').replace('export function', 'function'), ctx);
+    const screen = {
+      container: { querySelector: () => heroNode },
+      heroItem: { id: 'new', heroMetaEnriching: true }, layoutMode: 'modern',
+      scheduleHomeTruncationUpdate() {}, syncCollectionHeroMedia() {}, applyHeroDescriptionAutoScroll() {}
+    };
+    ctx.createHomeScreenMethods05().applyHeroToDom.call(screen);
+    assert.equal(swaps.length, isC1 ? 1 : 0);
+    if (isC1) assert.equal(swaps[0][4].transitionMode, 'instant');
+  }
+});
+for (const kind of ['backdrop', 'logo']) {
+  test(`${kind}: instant swap retains old image until loaded, without fades or clones`, async () => {
+    const f = fixture(kind);
+    f.swap(f.img, 'new', 'Title', 400, { transitionMode: 'instant' });
+    assert.equal(f.img.attrs.src, 'old');
+    f.pending[0].resolve(true); await Promise.resolve();
+    assert.equal(f.img.attrs.src, 'new');
+    assert.equal(f.frames.length, 0);
+    assert.equal(f.ghosts(), 0);
+    assert.equal(f.enters(), 0);
+  });
+  test(`${kind}: stale load cannot replace newer selection`, async () => {
+    const f = fixture(kind);
+    f.swap(f.img, 'stale', '', 400, { transitionMode: 'instant' });
+    f.swap(f.img, 'latest', '', 400, { transitionMode: 'instant' });
+    f.pending[1].resolve(true); await Promise.resolve();
+    f.pending[0].resolve(true); await Promise.resolve();
+    assert.equal(f.img.attrs.src, 'latest');
+  });
+  test(`${kind}: failed preload still delegates to image fallback`, async () => {
+    const f = fixture(kind);
+    f.swap(f.img, 'failed', '', 400, { transitionMode: 'instant' });
+    f.pending[0].resolve(false); await Promise.resolve();
+    assert.equal(f.img.attrs.src, 'failed');
+  });
+  test(`${kind}: normal crossfade is preserved`, async () => {
+    const f = fixture(kind);
+    f.swap(f.img, 'new');
+    f.pending[0].resolve(true); await Promise.resolve();
+    assert.equal(f.ghosts(), 1);
+    assert.equal(f.enters(), 1);
+    assert.equal(f.frames.length, 1);
+  });
+}
