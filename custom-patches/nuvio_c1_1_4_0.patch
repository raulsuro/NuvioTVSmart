diff --git a/scripts/test-c1-hero-entrance.mjs b/scripts/test-c1-hero-entrance.mjs
new file mode 100644
index 0000000..6221865
--- /dev/null
+++ b/scripts/test-c1-hero-entrance.mjs
@@ -0,0 +1,69 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+const path = 'js/ui/screens/home/c1HeroEntrance.js';
+const source = fs.existsSync(path) ? fs.readFileSync(path, 'utf8') : 'function prepareC1HeroEntrance() {} function revealC1HeroEntrance() {}';
+function fixture({ c1 = true, reduced = false } = {}) {
+  const pending = [], frames = [], animations = [];
+  const classes = new Set();
+  const classList = { add: c => classes.add(c), remove: c => classes.delete(c), contains: c => classes.has(c) };
+  const node = { dataset: { itemId: 'a' }, animate: (keys, options) => {
+    const a = { keys, options, cancelled: false, cancel() { this.cancelled = true; } }; animations.push(a); return a;
+  } };
+  const screen = { layoutMode: 'modern', container: { classList, contains: n => n === node } };
+  const ctx = vm.createContext({
+    document: { documentElement: { classList: { contains: () => c1 } } },
+    window: { matchMedia: () => ({ matches: reduced }) },
+    Router: { getCurrent: () => 'home' },
+    preloadImageSource: () => new Promise(resolve => pending.push(resolve)),
+    requestAnimationFrame: fn => frames.push(fn)
+  });
+  vm.runInContext(source.replace(/^import .*;\s*$/gm, '').replaceAll('export function', 'function'), ctx);
+  return { ctx, screen, node, classes, pending, frames, animations };
+}
+async function finish(f) {
+  f.pending.splice(0).forEach(resolve => resolve(true));
+  await new Promise(resolve => setImmediate(resolve));
+  while (f.frames.length) f.frames.shift()();
+}
+test('first resolved hero waits for artwork and fades as one unit once', async () => {
+  const f = fixture();
+  f.ctx.prepareC1HeroEntrance(f.screen);
+  assert.ok(f.classes.has('c1-hero-entrance-pending'));
+  f.ctx.revealC1HeroEntrance(f.screen, f.node, { id: 'a' }, { backdrop: 'bg', logo: 'logo' });
+  assert.equal(f.animations.length, 0);
+  await finish(f);
+  assert.equal(f.animations.length, 1);
+  assert.equal(f.animations[0].options.duration, 180);
+  assert.equal(f.classes.has('c1-hero-entrance-pending'), false);
+  f.ctx.prepareC1HeroEntrance(f.screen);
+  f.ctx.revealC1HeroEntrance(f.screen, f.node, { id: 'b' }, {});
+  assert.equal(f.animations.length, 1);
+  assert.equal(f.animations[0].cancelled, true);
+  assert.equal(f.classes.has('c1-hero-entrance-pending'), false);
+});
+test('unresolved metadata cannot reveal the provisional hero', () => {
+  const f = fixture(); f.ctx.prepareC1HeroEntrance(f.screen);
+  f.ctx.revealC1HeroEntrance(f.screen, f.node, { id: 'a', heroMetaEnriching: true }, {});
+  assert.equal(f.pending.length, 0);
+  assert.equal(f.animations.length, 0);
+});
+test('stale artwork completion cannot reveal a different hero', async () => {
+  const f = fixture(); f.ctx.prepareC1HeroEntrance(f.screen);
+  f.ctx.revealC1HeroEntrance(f.screen, f.node, { id: 'a' }, {});
+  f.node.dataset.itemId = 'b'; await finish(f);
+  assert.equal(f.animations.length, 0);
+  assert.ok(f.classes.has('c1-hero-entrance-pending'));
+});
+test('reduced motion reveals without animation', async () => {
+  const f = fixture({ reduced: true }); f.ctx.prepareC1HeroEntrance(f.screen);
+  f.ctx.revealC1HeroEntrance(f.screen, f.node, { id: 'a' }, {}); await finish(f);
+  assert.equal(f.animations.length, 0);
+  assert.equal(f.classes.has('c1-hero-entrance-pending'), false);
+});
+test('other TVs remain untouched', () => {
+  const f = fixture({ c1: false }); f.ctx.prepareC1HeroEntrance(f.screen);
+  f.ctx.revealC1HeroEntrance(f.screen, f.node, { id: 'a' }, {});
+  assert.equal(f.classes.size, 0); assert.equal(f.pending.length, 0);
+});
