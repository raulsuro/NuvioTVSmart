+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+const source = fs.readFileSync('js/core/player/playerControllerMethods-18-play.js', 'utf8')
+  .replace(/^import .*;\s*$/gm, '').replace('export function', 'function');
+async function run(route, invalidate = false) {
+  const original = 'https://addon.example/redirect/movie.mkv';
+  const resolved = 'https://cdn.example/movie.mkv';
+  const proxy = 'http://127.0.0.1:2710/proxy/movie.mkv';
+  let attempts = 0;
+  const webosProxy = {
+    requiresProxy: () => route !== 'unchanged',
+    resolve: async () => route === 'unchanged'
+      ? { status: 'not-required', proxied: false, url: original }
+      : { status: 'success', proxied: true, url: proxy }
+  };
+  const ctx = vm.createContext({
+    URL, console,
+    observeProxyRedirects: () => () => {},
+    describeSourceHost: () => 'example',
+    isDirectMediaProbeResponse: () => true,
+    resolveTizenDirectRedirect: async () => route === 'redirect'
+      ? { reason: 'resolved', url: resolved, details: { status: 206 } }
+      : { reason: 'fetch-failed' },
+    internals: {
+      Platform: { isWebOS: () => true, isTizen: () => false },
+      WebOsPlaybackProxy: webosProxy, TizenPlaybackProxy: {},
+      logEngineFsDebug() {}, logTizenAvPlayDebug() {}, logWebOsPlaybackDebug() {}
+    }
+  });
+  vm.runInContext(source, ctx);
+  const state = {
+    playRequestToken: 0,
+    video: { querySelectorAll: () => [], pause() {}, removeAttribute() {}, load() {} },
+    resolveRuntimeSourceType: x => x,
+    resolveRemoteMediaSourceType: async () => 'video/x-matroska',
+    choosePlaybackEngine: () => 'native-file',
+    getPlatformAvplayEngineName: () => 'avplay',
+    isLikelyHlsMimeType: () => false,
+    isLikelyDashMimeType: () => false,
+    isTizenHlsSource: () => false,
+    isEngineFsPlaybackUrl: () => false,
+    normalizeMimeType: x => x,
+    isPlaybackRequestActive(token, url = null) {
+      return token === this.playRequestToken && (url === null || url === this.currentPlaybackUrl);
+    },
+    async prepareWebOsStagedNativePlayback() {
+      if (invalidate) this.playRequestToken += 1;
+    },
+    attemptVideoPlay() { attempts += 1; }
+  };
+  const controller = new Proxy(state, {
+    get(target, key) { return key in target ? target[key] : () => {}; }
+  });
+  await ctx.createPlayerControllerMethods18().play.call(controller, original, { requestHeaders: { Referer: 'https://addon.example/' } });
+  return { attempts, state };
+}
+for (const route of ['redirect', 'proxy', 'unchanged']) {
+  test('staged webOS playback starts after ' + route, async () => {
+    assert.equal((await run(route)).attempts, 1);
+  });
+  test('cancelled staged playback stays stopped after ' + route, async () => {
+    assert.equal((await run(route, true)).attempts, 0);
+  });
+}
