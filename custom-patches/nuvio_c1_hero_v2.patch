+:root.webos-2021-fast-resume .home-screen-shell.home-layout-modern .home-modern-hero-copy {
+  visibility: visible !important;
+}
+
+:root.webos-2021-fast-resume .home-screen-shell .home-modern-hero-copy,
+:root.webos-2021-fast-resume .home-screen-shell .home-modern-hero-copy *,
+:root.webos-2021-fast-resume .home-screen-shell .home-hero-backdrop,
+:root.webos-2021-fast-resume .home-screen-shell .home-hero-logo {
+  transition: none !important;
+}
+
+/* Only neutralize the enter state; preserve trailer-driven opacity rules. */
+:root.webos-2021-fast-resume .home-screen-shell .home-hero-logo.home-hero-logo-transition-enter {
+  opacity: 1;
+}
+
+/* Avoid filtering the large backdrop on each repaint on Chromium 79. */
+:root.webos-2021-fast-resume .home-screen-shell .home-hero-backdrop {
+  filter: none !important;
+}
