diff --git a/scripts/test-c1-resolved-hero.mjs b/scripts/test-c1-resolved-hero.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/test-c1-resolved-hero.mjs
@@ -0,0 +1,53 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+const source = fs.readFileSync(process.env.HERO_SCHEDULER || 'js/ui/screens/home/homeScreenMethods-10-schedule-modern-hero-update.js', 'utf8');
+function run(c1, needsEnrichment) {
+  const timers = [], frames = [], preloads = [], commits = [], enrichments = [];
+  const hero = { id: 'new', type: 'movie', heroMetaEnriched: !needsEnrichment };
+  const node = { isConnected: true, classList: { contains: () => true } };
+  const ctx = vm.createContext({
+    document: { documentElement: { classList: { contains: () => c1 } } },
+    internals: {
+      MODERN_HOME_CONSTANTS: { heroRapidNavThresholdMs: 200 },
+      shouldEnrichModernHero: () => needsEnrichment,
+      preloadHeroAssets: h => preloads.push(h.id),
+      buildHeroIdentity: h => h?.id || ''
+    },
+    isModernTvProfile: () => false, getTvRuntimePerformanceProfile: () => ({}),
+    setTimeout: fn => { timers.push(fn); return timers.length; },
+    requestAnimationFrame: fn => frames.push(fn)
+  });
+  vm.runInContext(source.replace(/^import .*;\s*$/gm, '').replace('export function', 'function'), ctx);
+  const screen = {
+    layoutMode: 'modern', heroItem: { id: 'old' }, heroCandidates: [],
+    container: { querySelector: () => ({ classList: { add() {}, remove() {} } }) },
+    getNodeHeroSource: () => hero, getCurrentFocusedNode: () => node,
+    cancelPendingHeroFocus() {}, getHeroFocusDelay: () => 150,
+    applyHeroToDom() { commits.push(this.heroItem.id); },
+    enrichCurrentHeroAsync: (...args) => enrichments.push(args)
+  };
+  ctx.createHomeScreenMethods10().scheduleModernHeroUpdate.call(screen, node);
+  while (timers.length) timers.shift()();
+  while (frames.length) frames.shift()();
+  return { screen, preloads, commits, enrichments };
+}
+test('C1 skips catalog preview and its artwork preload while resolving metadata', () => {
+  const f = run(true, true);
+  assert.deepEqual(f.commits, []);
+  assert.deepEqual(f.preloads, []);
+  assert.equal(f.enrichments.length, 1);
+  assert.equal(f.enrichments[0][2].deferCommit, true);
+});
+test('C1 displays an already resolved catalog item immediately', () => {
+  const f = run(true, false);
+  assert.deepEqual(f.commits, ['new']);
+  assert.equal(f.enrichments.length, 0);
+});
+test('other platforms retain the immediate preview', () => {
+  const f = run(false, true);
+  assert.deepEqual(f.commits, ['new']);
+  assert.equal(f.preloads.length, 1);
+  assert.equal(f.enrichments.length, 1);
+});
