@@ -0,0 +1,87 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import vm from "node:vm";
+const read = name => fs.readFileSync("js/ui/screens/settings/" + name, "utf8")
+  .replace(/^import[\s\S]*?;\r?\n/gm, "").replace(/^export /gm, "");
+function setup(c1 = true) {
+  const sectionList = [{ id: "layout" }, { id: "playback" }];
+  const counts = { root: 0, nav: 0, content: 0, reflow: 0 };
+  const slot = name => ({
+    value: "", firstElementChild: null,
+    get innerHTML() { return this.value + (this.value ? "<!--runtime-->" : ""); },
+    set innerHTML(value) { counts[name]++; this.value = value; this.firstElementChild = {}; },
+    classList: { remove() {}, add() {}, toggle() {} },
+    get offsetWidth() { counts.reflow++; return 100; },
+    querySelectorAll: () => [], addEventListener() {}, removeEventListener() {}
+  });
+  const root = slot("root"), nav = slot("nav"), content = slot("content"), dialog = slot("dialog");
+  const buttons = sectionList.map(section => ({ dataset: { section: section.id }, selected: false,
+    classList: { toggle(name, selected) { section.selected = selected; } },
+    setAttribute(name, value) { section[name] = value; } }));
+  nav.querySelectorAll = () => buttons;
+  const shell = { dataset: {}, classList: { toggle() {} } };
+  const slots = { ".settings-shell": shell, "[data-settings-root-sidebar]": root,
+    "[data-settings-nav]": nav, "[data-settings-content]": content, "[data-settings-dialog]": dialog };
+  const context = vm.createContext({
+    document: { documentElement: { classList: { contains: () => c1 } } },
+    internals: {
+      ScreenUtils: { routeEnterClass: () => "", indexFocusables() {} },
+      renderRootSidebar: () => "<aside>Menu</aside>", bindRootSidebarEvents() {},
+      SECTION_META: sectionList, clamp: (v, a, b) => Math.max(a, Math.min(b, v)),
+      getVisibleSections: () => sectionList,
+      getSettingsSectionById: id => sectionList.find(s => s.id === id),
+      updateSettingsRailIndicatorsSoon() {}, updateSettingsScrollIndicatorsSoon() {},
+      syncLayoutPreviewMetricsSoon() {}, bindSettingsScrollIndicators() {},
+      captureSettingsScrollState: () => ({}), restoreSettingsScrollState() {},
+      escapeHtml: s => s, translateSectionCopy: s => ({ label: s.id }),
+      renderSectionNavIcon: () => "", iconSvg: () => "", ROW_ICONS: {},
+    }
+  });
+  vm.runInContext(read("settingsScreenMethods-01-get-current-rail-scroll-top.js") +
+    read("settingsScreenMethods-12-render-trakt-stats-strip.js"), context);
+  const screen = {
+    container: { querySelector: s => slots[s] || null },
+    model: { layout: {}, theme: {} }, activeSection: "layout", navIndex: 0,
+    ensureExpandedState() {}, persistUiState() {}, ensureShell() {},
+    renderNav: context.createSettingsScreenMethods01().renderNav,
+    renderSection: section => "<p>" + section.id + "</p>",
+    renderTextDialog: () => "", bindTextDialogEvents() {}, applyFocus() {}
+  };
+  const render = () => context.createSettingsScreenMethods12().render.call(screen, { refreshModel: false });
+  return { render, screen, counts, nav, root, sectionList };
+}
+test("C1 keeps navigation and root nodes while switching settings sections", async () => {
+  const f = setup(); await f.render();
+  f.screen.activeSection = "playback"; await f.render();
+  assert.equal(f.counts.nav, 1);
+  assert.equal(f.counts.root, 1);
+  assert.equal(f.counts.content, 2);
+  assert.equal(f.counts.reflow, 0);
+  assert.equal(f.sectionList[0].selected, false);
+  assert.equal(f.sectionList[1].selected, true);
+  assert.equal(f.sectionList[1]['aria-selected'], 'true');
+});
+test("C1 rebuilds a replaced nav slot instead of trusting stale cached markup", async () => {
+  const f = setup(); await f.render(); f.nav.firstElementChild = null;
+  await f.render(); assert.equal(f.counts.nav, 2);
+});
+test("other TVs retain section transition behavior", async () => {
+  const f = setup(false); await f.render();
+  f.screen.activeSection = "playback"; await f.render();
+  assert.equal(f.counts.reflow, 1);
+});
+
+test('C1 settings rail lands immediately without a spring animation', () => {
+  let frames = 0;
+  const ctx = vm.createContext({
+    document: { documentElement: { classList: { contains: () => true } } },
+    requestAnimationFrame: () => ++frames, cancelAnimationFrame() {}, performance: { now: () => 0 },
+    SETTINGS_RAIL_SCROLL_DAMPING_RATIO: 0.95, SETTINGS_RAIL_SCROLL_STIFFNESS: 180
+  });
+  vm.runInContext(read('settingsScreenHelpers-09-update-settings-marquee-targets.js'), ctx);
+  const rail = { scrollTop: 0, closest: () => null };
+  ctx.animateSettingsRailScroll(rail, 198);
+  assert.equal(rail.scrollTop, 198);
+  assert.equal(frames, 0);
+});
