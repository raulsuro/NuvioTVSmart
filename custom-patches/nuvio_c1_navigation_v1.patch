+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+const source = fs.readFileSync('js/ui/screens/home/homeScreenMethods-23-render.js', 'utf8');
+function decision(name, state, c1 = true, mounted = true) {
+  const expression = source.match(new RegExp('const ' + name + ' = (Boolean\\([\\s\\S]*?\\n      \\));'))?.[1];
+  assert.ok(expression, name + ' declaration');
+  const context = vm.createContext({ state, c1Fast: c1, hasMountedHomeDom: () => mounted,
+    updatedInPlace: true, liveFocusedNode: { isConnected: true, classList: { contains: () => true } } });
+  return vm.runInContext('(function(){ return ' + expression + '; }).call(state)', context);
+}
+const state = () => ({ container: { contains: () => true }, layoutMode: 'modern', renderedLayoutMode: 'modern',
+  homeRouteEnterPending: true, isRestoringFocusFromBack: true, pendingBackFocusState: { id: 'saved' } });
+test('C1 return reconciles a mounted Home instead of replacing posters', () => {
+  assert.equal(decision('canUpdateInPlace', state()), true);
+});
+test('cold Home and layout changes still rebuild', () => {
+  assert.equal(decision('canUpdateInPlace', state(), true, false), false);
+  assert.equal(decision('canUpdateInPlace', { ...state(), layoutMode: 'grid' }), false);
+});
+test('other TVs retain their return behavior', () => {
+  assert.equal(decision('canUpdateInPlace', state(), false), false);
+});
+test('retained focus does not bypass saved Back focus restoration', () => {
+  assert.equal(decision('focusSurvived', state()), false);
+  assert.equal(decision('focusSurvived', { ...state(), isRestoringFocusFromBack: false, pendingBackFocusState: null }), true);
+});
