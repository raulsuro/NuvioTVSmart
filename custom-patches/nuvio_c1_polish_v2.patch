diff --git a/js/ui/screens/home/homeScreenMethods-24-schedule-home-lazy-image-hydration.js b/js/ui/screens/home/homeScreenMethods-24-schedule-home-lazy-image-hydration.js
--- a/js/ui/screens/home/homeScreenMethods-24-schedule-home-lazy-image-hydration.js
+++ b/js/ui/screens/home/homeScreenMethods-24-schedule-home-lazy-image-hydration.js
@@ -308,5 +308,19 @@
     },
     assignHomeLazyImageSource(image, src, priority = 2) {
+      // Fade only for new src assignments. No replay when focus changes.
+      if (image.classList.contains("content-poster") && !image.getAttribute("src") && typeof image.classList.add === "function" && typeof image.addEventListener === "function" && typeof image.removeEventListener === "function") {
+        image.c1FinishPosterFade?.();
+        image.classList.add("c1-poster-loading");
+        const finish = () => {
+          image.removeEventListener("load", finish);
+          image.removeEventListener("error", finish);
+          image.classList.remove("c1-poster-loading");
+          if (image.c1FinishPosterFade === finish) image.c1FinishPosterFade = null;
+        };
+        image.c1FinishPosterFade = finish;
+        image.addEventListener("load", finish);
+        image.addEventListener("error", finish);
+      }
       // The app already decided this image is close enough to load, so stop
       // deferring to the browser's own lazy heuristic.
       image.loading = "eager";
diff --git a/js/ui/screens/detail/metaDetailsScreenMethods-17-capture-detail-focus.js b/js/ui/screens/detail/metaDetailsScreenMethods-17-capture-detail-focus.js
--- a/js/ui/screens/detail/metaDetailsScreenMethods-17-capture-detail-focus.js
+++ b/js/ui/screens/detail/metaDetailsScreenMethods-17-capture-detail-focus.js
@@ -298,6 +298,12 @@
         this.pendingEpisodeSelection ||
         this.pendingMovieSelection ||
         this.shouldSuppressTrailerAutoplay() ||
+        // On constrained LG webOS, auto-embedded YouTube trailers can show
+        // "Video player configuration error" while idle. Keep static artwork;
+        // manual trailer selection remains available.
+        (globalThis.__NUVIO_PLATFORM__ === "webos" &&
+          this.isPerformanceConstrained() &&
+          this.trailerSource.kind === "youtube") ||
         !PlayerSettingsStore.get().trailerAutoplay
       ) {
         return;
diff --git a/css/components-61.css b/css/components-61.css
--- a/css/components-61.css
+++ b/css/components-61.css
@@ -194,3 +194,33 @@
   text-align: center;
   pointer-events: none;
 }
+
+/* C1 polish: two static rings, not an expensive animated blur. */
+.performance-constrained .home-screen-shell .home-poster-card.focused .home-poster-frame {
+  box-shadow: 0 0 0 2px var(--secondary-color), 0 0 0 6px rgb(var(--secondary-color-rgb) / 0.22) !important;
+}
+
+/* Loaded posters fade into place without animating layout or scroll. */
+.performance-constrained .home-screen-shell .home-poster-card .content-poster {
+  transition: opacity 190ms ease-out !important;
+}
+.performance-constrained .home-screen-shell .home-poster-card .content-poster.c1-poster-loading {
+  opacity: 0 !important;
+}
+
+/* Prevent detail action edges and focus indications being cropped. */
+.series-detail-actions {
+  overflow: visible;
+  padding-top: 10px;
+  padding-bottom: 10px;
+}
+.series-detail-actions .series-primary-btn,
+.series-detail-actions .series-circle-btn {
+  box-sizing: border-box;
+  flex-shrink: 0;
+}
+@media (prefers-reduced-motion: reduce) {
+  .performance-constrained .home-screen-shell .home-poster-card .content-poster {
+    transition: none !important;
+  }
+}
