+/* LG 2021 webOS 6 (Chromium 79) lacks content-visibility. Experimental:
+   keep Home laid out between routes so return doesn't relayout every row.
+   It remains hidden/off-screen with pointer events disabled. */
+@supports not (content-visibility: hidden) {
+  :root.webos-2021-fast-resume #home.home-dom-preserved {
+    display: block !important;
+    visibility: hidden !important;
+    pointer-events: none !important;
+  }
+}
+
+/* Instant poster reveal on the C1. Do not animate every decoded bitmap.
+   The custom polish may still attach load listeners; these rules avoid the
+   expensive opacity animation and the extra visual delay. */
+:root.webos-2021-fast-resume.performance-constrained .home-screen-shell .home-poster-card .content-poster {
+  transition: none !important;
+}
+:root.webos-2021-fast-resume.performance-constrained .home-screen-shell .home-poster-card .content-poster.c1-poster-loading {
+  opacity: 1 !important;
+}
+
 #home.home-dom-preserved .root-sidebar-legacy,
