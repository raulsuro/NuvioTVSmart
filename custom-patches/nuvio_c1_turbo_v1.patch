+      const runtime = getTvRuntimePerformanceProfile();
+      if (reason === "route-resume" && runtime.platform === "webos" && runtime.tvYear === 2021) {
+        const token = this.homeLoadToken;
+        const startedAt = Date.now();
+        await new Promise((resolve) => setTimeout(resolve, 450));
+        while (
+          Date.now() - Number(this.lastHomeInputAt || 0) < 650 &&
+          Date.now() - startedAt < 2000 &&
+          token === this.homeLoadToken &&
+          Router.getCurrent() === "home"
+        ) {
+          await new Promise((resolve) => setTimeout(resolve, 150));
+        }
+        // A route or profile change during the pause must cancel stale work.
+        if (token !== this.homeLoadToken || Router.getCurrent() !== "home") return false;
