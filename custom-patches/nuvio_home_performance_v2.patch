diff --git a/js/ui/images/tvPosterRescalerWarmCache.test.mjs b/js/ui/images/tvPosterRescalerWarmCache.test.mjs
new file mode 100644
--- /dev/null
+++ b/js/ui/images/tvPosterRescalerWarmCache.test.mjs
@@ -0,0 +1,102 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+// Each Node test file gets its own process, so these globals cannot affect
+// the repository's other poster-worker tests.
+Object.defineProperty(globalThis, "navigator", {
+  value: { hardwareConcurrency: 2, deviceMemory: 1 },
+  configurable: true
+});
+
+const created = [];
+const revoked = [];
+let sequence = 0;
+URL.createObjectURL = () => `blob:home-test-${++sequence}`;
+URL.revokeObjectURL = (url) => revoked.push(url);
+
+class FakeWorker {
+  constructor() {
+    this.posted = [];
+    this.terminated = false;
+    created.push(this);
+  }
+  postMessage(message) {
+    this.posted.push(message);
+  }
+  terminate() {
+    this.terminated = true;
+  }
+}
+globalThis.Worker = FakeWorker;
+
+const { rescaleHomeArtwork, releaseHomeArtwork, resetHomeArtworkRescaler } =
+  await import("./tvPosterRescaler.js");
+const BOX = { width: 220, height: 338, fit: "cover" };
+
+function reset() {
+  resetHomeArtworkRescaler();
+  created.length = 0;
+  revoked.length = 0;
+}
+function answerOne() {
+  const worker = created.find((candidate) => !candidate.terminated && candidate.posted.length);
+  assert.ok(worker, "a worker should have received the pending request");
+  const job = worker.posted.shift();
+  worker.onmessage({ data: { id: job.id, ok: true, blob: { size: 12345 } } });
+}
+async function resized(url) {
+  const pending = rescaleHomeArtwork(url, BOX);
+  answerOne();
+  return pending;
+}
+
+test("Home return reuses released thumbnail without re-decoding", async () => {
+  reset();
+  const first = await resized("https://example.test/poster-1.jpg");
+  releaseHomeArtwork(first);
+  resetHomeArtworkRescaler({ retainCacheEntries: 12 });
+  assert.ok(!revoked.includes(first), "released thumbnail should remain warm");
+
+  const second = await rescaleHomeArtwork("https://example.test/poster-1.jpg", BOX);
+  assert.equal(second, first, "revisited poster should reuse its blob URL");
+  releaseHomeArtwork(second);
+  resetHomeArtworkRescaler();
+  assert.ok(revoked.includes(first), "an explicit reset must free the warm URL");
+});
+
+test("warm cache retains at most twelve recently used thumbnails", async () => {
+  reset();
+  const urls = [];
+  for (let i = 0; i < 20; i += 1) {
+    const url = await resized(`https://example.test/poster-${i}.jpg`);
+    urls.push(url);
+    releaseHomeArtwork(url);
+  }
+  resetHomeArtworkRescaler({ retainCacheEntries: 12 });
+  for (const url of urls.slice(0, 8)) {
+    assert.ok(revoked.includes(url), "oldest released thumbnails should be dropped");
+  }
+  for (const url of urls.slice(-12)) {
+    assert.ok(!revoked.includes(url), "most recent thumbnails should remain warm");
+  }
+  reset();
+});
+
+test("a still-referenced blob is never added to the warm cache", async () => {
+  reset();
+  const released = await resized("https://example.test/released.jpg");
+  const active = await resized("https://example.test/active.jpg");
+  releaseHomeArtwork(released);
+  resetHomeArtworkRescaler({ retainCacheEntries: 12 });
+  assert.ok(!revoked.includes(released));
+  assert.ok(revoked.includes(active), "legacy full teardown behavior applies to active blobs");
+  reset();
+});
+
+test("the default teardown retains nothing", async () => {
+  reset();
+  const img = await resized("https://example.test/default.jpg");
+  releaseHomeArtwork(img);
+  resetHomeArtworkRescaler();
+  assert.ok(revoked.includes(img));
+});
diff --git a/js/ui/screens/home/homeImageCommitQueue.test.mjs b/js/ui/screens/home/homeImageCommitQueue.test.mjs
new file mode 100644
--- /dev/null
+++ b/js/ui/screens/home/homeImageCommitQueue.test.mjs
@@ -0,0 +1,88 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import vm from "node:vm";
+
+const source = await readFile(
+  new URL("./homeScreenMethods-24-schedule-home-lazy-image-hydration.js", import.meta.url),
+  "utf8"
+);
+
+function makeContext() {
+  const frames = [];
+  const context = vm.createContext({
+    internals: { HOME_LEGACY_LAZY_HYDRATION_MAX_PER_FRAME: 2 },
+    requestAnimationFrame: (callback) => {
+      frames.push(callback);
+      return frames.length;
+    }
+  });
+  context.HTMLElement = class {};
+  context.HTMLImageElement = class extends context.HTMLElement {};
+  context.globalThis = context;
+  // The factory already exists in the app. Stub just its imports so the test
+  // calls the real queue implementation without loading the whole Home UI.
+  const code = source
+    .replace(/^import [\s\S]*?;\s*/gm, "")
+    .replace("export function", "function");
+  vm.runInContext(`${code}\nglobalThis.methods = createHomeScreenMethods24();`, context);
+  return { frames, context };
+}
+
+function image(context, id) {
+  const node = new context.HTMLImageElement();
+  node.id = id;
+  node.dataset = { src: id };
+  node.isConnected = true;
+  node.closest = () => null;
+  return node;
+}
+
+test("Home queue deduplicates rapid focus entries and prioritizes the new focus", () => {
+  const { context, frames } = makeContext();
+  const row = {};
+  const first = image(context, "first");
+  const second = image(context, "second");
+  const focused = image(context, "focused");
+  const started = [];
+  const screen = {
+    ...context.methods,
+    assignHomeLazyImageSource(node) {
+      started.push(node.id);
+      delete node.dataset.src;
+    }
+  };
+  const entries = [first, second].map((node) => ({ image: node, src: node.id, row, priority: 2 }));
+  screen.commitHomeLazyImageSources(entries, null, row);
+  // Re-queueing an existing pending poster must not duplicate its request.
+  screen.commitHomeLazyImageSources(entries, null, row);
+  assert.equal(screen.homeLazyImageCommitQueue.length, 2);
+
+  const anchor = { contains: (node) => node === focused };
+  screen.commitHomeLazyImageSources([{ image: focused, src: focused.id, row, priority: 0 }], anchor, row);
+  assert.equal(screen.homeLazyImageCommitQueue.length, 3);
+  while (frames.length) frames.shift()();
+  assert.equal(started.length, 3);
+  assert.equal(started[0], "focused", "focused card should take the first slot");
+});
+
+test("Home queue drops images detached during navigation", () => {
+  const { context, frames } = makeContext();
+  const row = {};
+  const stale = image(context, "stale");
+  const live = image(context, "live");
+  const started = [];
+  const screen = {
+    ...context.methods,
+    assignHomeLazyImageSource(node) {
+      started.push(node.id);
+      delete node.dataset.src;
+    }
+  };
+  screen.commitHomeLazyImageSources([{ image: stale, src: "stale", row, priority: 1 }], null, row);
+  stale.isConnected = false;
+  screen.commitHomeLazyImageSources([{ image: live, src: "live", row, priority: 1 }], null, row);
+  assert.equal(screen.homeLazyImageCommitQueue.length, 1);
+  while (frames.length) frames.shift()();
+  assert.deepEqual(started, ["live"]);
+});
