+  // webOS may evict a Luna JS service between source selection and player
+  // startup. Keep-alive subscriptions must recover without a permanent
+  // external SSH process. Scope reconnection to playback keep-alives: other
+  // subscriptions retain their existing lifecycle and failure semantics.
+  const recoverable = RECOVERABLE_SUBSCRIPTIONS.has(method);
+  let closed = false;
+  let generation = 0;
+  let retryTimer = null;
+  let failures = 0;
+  let handle = null;
+
+  const scheduleRetry = () => {
+    if (!recoverable || closed || retryTimer) return;
+    const delayMs = Math.min(8000, 250 * 2 ** Math.min(failures, 5));
+    failures += 1;
+    retryTimer = setTimeout(() => {
+      retryTimer = null;
+      connect();
+    }, delayMs);
+  };
+
+  const connect = () => {
+    if (closed) return;
+    // Increment first, so a cancellation callback from the old handle cannot
+    // schedule another reconnect after a newer subscription has replaced it.
+    const currentGeneration = ++generation;
+    try {
+      handle?.cancel?.();
+    } catch (_) {
+      // A terminated webOS service may leave a handle that cannot be cancelled.
+    }
+    handle = null;
+    try {
+      handle = WebOsLunaService.subscribe(`luna://${serviceId}`, {
+        method,
+        parameters,
+        onSuccess: (payload) => {
+          if (closed || currentGeneration !== generation) return;
+          failures = 0;
+          if (retryTimer) {
+            clearTimeout(retryTimer);
+            retryTimer = null;
+          }
+          onSuccess?.(payload);
+        },
+        onFailure: (error) => {
+          if (closed || currentGeneration !== generation) return;
+          scheduleRetry();
+          onFailure?.(error);
+        }
+      });
+    } catch (error) {
+      if (!recoverable) throw error;
+      scheduleRetry();
+      onFailure?.(error);
+    }
+  };
+
+  connect();
+  return {
+    cancel() {
+      closed = true;
+      generation += 1;
+      if (retryTimer) clearTimeout(retryTimer);
+      retryTimer = null;
+      try {
+        handle?.cancel?.();
+      } catch (_) {
+        // Ignore cancellation failures during route cleanup.
+      }
+      handle = null;
+    }
+  };
 }
