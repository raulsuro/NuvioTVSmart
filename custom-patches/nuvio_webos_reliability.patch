--- /dev/null
+++ b/js/platform/webos/webosCompanionService.test.mjs
@@ -0,0 +1,74 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { requestWebOsCompanionService, subscribeWebOsCompanionService } from "./webosCompanionService.js";
+const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+function mockBridge(t, onRequest) {
+  const oldWebOS = globalThis.webOS;
+  globalThis.webOS = { service: { request: (_url, args) => onRequest(args) } };
+  t.after(() => { globalThis.webOS = oldWebOS; });
+}
+
+test("status retry succeeds after initial companion failure", async (t) => {
+  let count = 0;
+  mockBridge(t, (args) => {
+    count += 1;
+    if (count === 1) queueMicrotask(() => args.onFailure({ errorText: "service not running" }));
+    else queueMicrotask(() => args.onSuccess({ returnValue: true, booted: true, url: "http://127.0.0.1:2710" }));
+    return { cancel() {} };
+  });
+  const result = await requestWebOsCompanionService({ method: "status", timeoutMs: 7000 });
+  assert.equal(count, 2);
+  assert.equal(result.payload.booted, true);
+});
+
+test("enginefsKeepAlive reconnects and cancel stops future retries", async (t) => {
+  let calls = 0;
+  let latest;
+  mockBridge(t, (args) => {
+    calls += 1;
+    latest = args;
+    if (calls === 1) queueMicrotask(() => args.onFailure({ errorText: "evicted" }));
+    else queueMicrotask(() => args.onSuccess({ returnValue: true }));
+    return { cancel() {} };
+  });
+  let successes = 0;
+  const subscription = subscribeWebOsCompanionService({
+    method: "enginefsKeepAlive",
+    onSuccess: () => { successes += 1; }
+  });
+  await delay(350);
+  assert.equal(calls, 2);
+  assert.equal(successes, 1);
+  subscription.cancel();
+  latest.onFailure({ errorText: "after cancel" });
+  await delay(350);
+  assert.equal(calls, 2);
+});
+
+test("cancel before a scheduled retry does not resubscribe", async (t) => {
+  let calls = 0;
+  mockBridge(t, (args) => {
+    calls += 1;
+    queueMicrotask(() => args.onFailure({ errorText: "evicted" }));
+    return { cancel() {} };
+  });
+  const subscription = subscribeWebOsCompanionService({ method: "enginefsKeepAlive" });
+  await delay(15);
+  subscription.cancel();
+  await delay(350);
+  assert.equal(calls, 1);
+});
+
+test("non-keepalive subscriptions are not reconnected", async (t) => {
+  let calls = 0;
+  mockBridge(t, (args) => {
+    calls += 1;
+    queueMicrotask(() => args.onFailure({ errorText: "failed" }));
+    return { cancel() {} };
+  });
+  const subscription = subscribeWebOsCompanionService({ method: "somethingElse" });
+  await delay(350);
+  subscription.cancel();
+  assert.equal(calls, 1);
+});
